# Copy to .env.local and fill in the values. Never commit .env.local.

# Same Supabase project as the main app. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# works instead of the anon key (add it only with a value; it wins if set).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never prefix it with NEXT_PUBLIC_. On Vercel, Production only and Sensitive.
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash
# GEMINI_MODEL=
